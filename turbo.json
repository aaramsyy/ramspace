{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "PORT",
    "VITE_WS_URL",
    "VITE_PROFILES_PUBLIC_ORIGIN",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "RAMSPACE_HOME",
    "RAMSPACE_DESKTOP_WS_URL",
    "RAMSPACE_BROWSER_HOST_PIPE_PATH",
    "RAMSPACE_BROWSER_USE_PIPE_PATH",
    "RAMSPACE_BROWSER_PERF",
    "RAMSPACE_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "RAMSPACE_GROK_ACP_DEBUG",
    "RAMSPACE_WEB_SOURCEMAP",
    "RAMSPACE_DEV_REACT_COMPILER",
    "RAMSPACE_SERVER_SOURCEMAP",
    "RAMSPACE_DESKTOP_SOURCEMAP",
    "RAMSPACE_MODE",
    "RAMSPACE_PORT",
    "RAMSPACE_NO_BROWSER",
    "RAMSPACE_AUTH_TOKEN",
    "RAMSPACE_PUBLIC_URL",
    "RAMSPACE_ALLOW_INSECURE_REMOTE",
    "RAMSPACE_LOG_WS_EVENTS",
    "RAMSPACE_HOST",
    "RAMSPACE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD",
    "RAMSPACE_ACCOUNT_URL",
    "RAMSPACE_ACCOUNT_PROFILE_SYNC"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "typecheck:native": {
      "dependsOn": ["^typecheck:native"],
      "outputs": [],
      "cache": false
    },
    "typecheck:legacy": {
      "dependsOn": ["^typecheck:legacy"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "outputs": []
    }
  }
}
